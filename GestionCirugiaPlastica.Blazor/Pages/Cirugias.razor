@page "/cirugias"
@attribute [Authorize(Roles = "Doctor")]
@inject HttpClient Http

<PageTitle>Cirugías | Tanger Clinic</PageTitle>
<div class="med-page">
    <header class="med-page-header">
        <div><h1>Cirugías</h1><p>Control clínico y seguimiento de operaciones</p></div>
        <button class="med-primary" @onclick="Nueva">Nueva cirugía</button>
    </header>
    @if (_error is not null) { <div class="med-error" role="alert">@_error</div> }
    <input class="med-search" placeholder="Buscar paciente, procedimiento o diagnóstico" @bind="_buscar" @bind:event="oninput" />
    @if (_form is not null)
    {
        <section class="med-card">
            <h2>@(_form.CirugiaId == 0 ? "Registrar cirugía" : "Editar cirugía")</h2>
            <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                <div class="med-grid">
                    <label>Paciente<select @bind="_form.PacienteId"><option value="0">Selecciona paciente</option>@foreach (var p in _pacientes) { <option value="@p.PacienteId">@p.Nombre @p.Apellido</option> }</select></label>
                    <label>Procedimiento / tipo<select @bind="_form.ProcedimientoId"><option value="0">Selecciona procedimiento</option>@foreach (var p in _procedimientos) { <option value="@p.ProcedimientoId">@p.Nombre</option> }</select></label>
                    <label>Fecha<InputDate @bind-Value="_form.FechaCirugia" /></label>
                    <label>Estado clínico<select @bind="_form.Estado">@foreach (var s in Estados) { <option value="@s">@s</option> }</select></label>
                    <label class="med-span">Diagnóstico preoperatorio<InputTextArea @bind-Value="_form.DiagnosticoPreoperatorio" /></label>
                    <label class="med-span">Notas / observaciones<InputTextArea @bind-Value="_form.Observaciones" /></label>
                </div>
                @if (_formError is not null) { <p class="med-error">@_formError</p> }
                <button class="med-primary" type="submit" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar")</button>
                <button class="med-secondary" type="button" @onclick="Cancelar">Cancelar</button>
            </EditForm>
        </section>
    }
    <section class="med-card">
        <div class="med-table-scroll"><table class="med-table">
            <thead><tr><th>Paciente</th><th>Procedimiento</th><th>Fecha</th><th>Diagnóstico preoperatorio</th><th>Estado</th><th>Acción</th></tr></thead>
            <tbody>
            @foreach (var c in CirugiasVisibles)
            {
                <tr>
                    <td>@c.Paciente?.Nombre @c.Paciente?.Apellido</td><td>@c.Procedimiento?.Nombre</td><td>@c.FechaCirugia.ToString("dd/MM/yyyy")</td>
                    <td>@(string.IsNullOrWhiteSpace(c.DiagnosticoPreoperatorio) ? "—" : c.DiagnosticoPreoperatorio)</td>
                    <td><select class="med-status" value="@c.Estado" @onchange="e => CambiarEstadoAsync(c, e)">@foreach (var s in Estados) { <option value="@s">@s</option> }</select></td>
                    <td><button class="med-secondary" @onclick="() => Editar(c)">Editar</button></td>
                </tr>
            }
            </tbody>
        </table></div>
        @if (_cirugias.Count == 0) { <p>No hay cirugías registradas.</p> }
    </section>
</div>

@code {
    private static readonly string[] Estados = ["Estudios preoperatorios", "Programada", "En proceso", "Postoperatorio / Recuperación", "Completada"];
    private List<CirugiaDto> _cirugias = new();
    private List<PersonaDto> _pacientes = new();
    private List<ProcedimientoDto> _procedimientos = new();
    private CirugiaForm? _form;
    private string _buscar = "";
    private string? _error, _formError;
    private bool _saving;
    private IEnumerable<CirugiaDto> CirugiasVisibles => _cirugias.Where(c => string.IsNullOrWhiteSpace(_buscar) || $"{c.Paciente?.Nombre} {c.Paciente?.Apellido} {c.Procedimiento?.Nombre} {c.DiagnosticoPreoperatorio}".Contains(_buscar, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cirugiasTask = Http.GetFromJsonAsync<Envelope<List<CirugiaDto>>>("api/Cirugias");
            var pacientesTask = Http.GetFromJsonAsync<Envelope<List<PersonaDto>>>("api/Pacientes");
            var procedimientosTask = Http.GetFromJsonAsync<Envelope<List<ProcedimientoDto>>>("api/Procedimientos");
            await Task.WhenAll(cirugiasTask, pacientesTask, procedimientosTask);
            _cirugias = (await cirugiasTask)?.Value ?? new();
            _pacientes = (await pacientesTask)?.Value ?? new();
            _procedimientos = (await procedimientosTask)?.Value ?? new();
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException) { _error = "No se pudo cargar la información clínica."; }
    }

    private void Nueva() { _formError = null; _form = new CirugiaForm { FechaCirugia = DateTime.Today, Estado = Estados[0] }; }
    private void Cancelar() { _form = null; _formError = null; }
    private void Editar(CirugiaDto c) => _form = new CirugiaForm { CirugiaId = c.CirugiaId, FechaCirugia = c.FechaCirugia, PacienteId = c.PacienteId, ProcedimientoId = c.ProcedimientoId, DiagnosticoPreoperatorio = c.DiagnosticoPreoperatorio, Estado = c.Estado, Observaciones = c.Observaciones };

    private async Task CambiarEstadoAsync(CirugiaDto c, ChangeEventArgs e)
    {
        var anterior = c.Estado;
        c.Estado = e.Value?.ToString() ?? anterior;
        using var response = await Http.PutAsJsonAsync($"api/Cirugias/{c.CirugiaId}", c.ToForm());
        if (!response.IsSuccessStatusCode) { c.Estado = anterior; _error = "No se pudo actualizar el estado clínico."; }
        else _error = null;
    }

    private async Task GuardarAsync()
    {
        if (_form is null) return;
        _saving = true; _formError = null;
        try
        {
            using var response = _form.CirugiaId == 0 ? await Http.PostAsJsonAsync("api/Cirugias", _form) : await Http.PutAsJsonAsync($"api/Cirugias/{_form.CirugiaId}", _form);
            if (!response.IsSuccessStatusCode) { _formError = "No se pudo guardar la cirugía. Revisa los campos y las relaciones seleccionadas."; return; }
            _form = null;
            var envelope = await Http.GetFromJsonAsync<Envelope<List<CirugiaDto>>>("api/Cirugias");
            _cirugias = envelope?.Value ?? new();
        }
        catch (HttpRequestException) { _formError = "No se pudo conectar con la API."; }
        finally { _saving = false; }
    }

    private sealed class Envelope<T> { public T? Value { get; set; } }
    private sealed class PersonaDto { public int PacienteId { get; set; } public string Nombre { get; set; } = ""; public string Apellido { get; set; } = ""; }
    private sealed class ProcedimientoDto { public int ProcedimientoId { get; set; } public string Nombre { get; set; } = ""; }
    private sealed class CirugiaDto { public int CirugiaId { get; set; } public DateTime FechaCirugia { get; set; } public int PacienteId { get; set; } public int ProcedimientoId { get; set; } public string? DiagnosticoPreoperatorio { get; set; } public string? Observaciones { get; set; } public string Estado { get; set; } = ""; public PersonaDto? Paciente { get; set; } public ProcedimientoDto? Procedimiento { get; set; } public CirugiaForm ToForm() => new() { CirugiaId = CirugiaId, FechaCirugia = FechaCirugia, PacienteId = PacienteId, ProcedimientoId = ProcedimientoId, DiagnosticoPreoperatorio = DiagnosticoPreoperatorio, Observaciones = Observaciones, Estado = Estado }; }
    private sealed class CirugiaForm { public int CirugiaId { get; set; } public DateTime FechaCirugia { get; set; } public int PacienteId { get; set; } public int ProcedimientoId { get; set; } public string? DiagnosticoPreoperatorio { get; set; } public string? Observaciones { get; set; } public string Estado { get; set; } = "Pendiente"; }
}
