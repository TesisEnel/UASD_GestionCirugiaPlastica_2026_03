@page "/configuracion"
@attribute [Authorize(Roles = "Doctora")]
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http

<PageTitle>Configuración | Tanger Clinic</PageTitle>

<div class="med-page account-page">
    <header class="med-page-header">
        <div><h1>Configuración</h1><p>Administra las cuentas, sus roles y el acceso al sistema.</p></div>
    </header>

    @if (_error is not null) { <div class="med-error" role="alert">@_error</div> }
    @if (_success is not null) { <div class="payment-success" role="status">@_success</div> }

    <section class="med-card">
        <div class="configuration-toolbar">
            <h2>Usuarios registrados</h2>
            <input class="med-search" aria-label="Buscar usuario" placeholder="Buscar por nombre, usuario o correo" @bind="_search" @bind:event="oninput" />
        </div>

        @if (_loading)
        {
            <p>Cargando usuarios…</p>
        }
        else if (_users.Count == 0)
        {
            <p>No hay usuarios registrados.</p>
        }
        else
        {
            <div class="med-table-scroll">
                <table class="med-table configuration-table">
                    <thead><tr><th>Usuario</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead>
                    <tbody>
                    @foreach (var usuario in UsuariosFiltrados)
                    {
                        <tr>
                            <td><strong>@usuario.Nombre @usuario.Apellido</strong><small>@(string.IsNullOrWhiteSpace(usuario.NombreUsuario) ? "Sin nombre de usuario" : $"@{usuario.NombreUsuario}")</small></td>
                            <td>@(usuario.Email ?? "—")</td>
                            <td>
                                <div class="configuration-role-control">
                                    <select aria-label="Rol de @usuario.Nombre @usuario.Apellido" @bind="usuario.RolSeleccionadoId">
                                        @foreach (var role in _roles)
                                        {
                                            <option value="@role.RolId">@role.Nombre</option>
                                        }
                                    </select>
                                    <button type="button" class="med-secondary" disabled="@(_savingUserId == usuario.UsuarioId || usuario.RolSeleccionadoId == usuario.RolId)" @onclick="() => CambiarRolAsync(usuario)">Guardar</button>
                                </div>
                            </td>
                            <td><span class="payment-status @(usuario.Activo ? "paid" : "pending")">@(usuario.Activo ? "Activo" : "Inactivo")</span></td>
                            <td>
                                <button type="button" class="@(usuario.Activo ? "med-secondary" : "med-primary")" disabled="@(_savingUserId == usuario.UsuarioId)" @onclick="() => CambiarEstadoAsync(usuario)">
                                    @(usuario.Activo ? "Desactivar" : "Activar")
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p class="configuration-note">Se asignan los cuatro roles del sistema. El sistema protege la última cuenta Doctora activa.</p>
        }
    </section>
</div>

@code {
    private static readonly string[] AllowedRoles = ["Doctora", "AsistenteClinico", "Secretaria", "Paciente"];
    private List<UserRow> _users = new();
    private List<RoleRow> _roles = new();
    private bool _loading = true;
    private int? _savingUserId;
    private string _search = "";
    private string? _error;
    private string? _success;

    private IEnumerable<UserRow> UsuariosFiltrados =>
        string.IsNullOrWhiteSpace(_search)
            ? _users
            : _users.Where(u => $"{u.Nombre} {u.Apellido} {u.NombreUsuario} {u.Email}"
                .Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var usersResult = await Http.GetFromJsonAsync<Envelope<List<UserDto>>>("api/Usuarios");
            var rolesResult = await Http.GetFromJsonAsync<Envelope<List<RoleDto>>>("api/Roles");
            _roles = (rolesResult?.Value ?? new())
                .Where(r => AllowedRoles.Contains(r.Nombre, StringComparer.OrdinalIgnoreCase))
                .OrderBy(r => Array.IndexOf(AllowedRoles, r.Nombre))
                .Select(r => new RoleRow { RolId = r.RolId, Nombre = r.Nombre })
                .ToList();
            _users = (usersResult?.Value ?? new())
                .Select(u => new UserRow
                {
                    UsuarioId = u.UsuarioId,
                    Nombre = u.Nombre,
                    Apellido = u.Apellido,
                    NombreUsuario = u.NombreUsuario,
                    Email = u.Email,
                    RolId = u.RolId,
                    RolSeleccionadoId = u.RolId,
                    Activo = u.Activo
                })
                .ToList();
            if (_roles.Count == 0)
                _error = "No se encontraron los roles Doctora, AsistenteClinico, Secretaria y Paciente en la base de datos.";
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo cargar la configuración. Confirma que tengas una sesión Doctora activa.";
        }
        catch (JsonException)
        {
            _error = "La API devolvió una respuesta con formato inesperado.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CambiarRolAsync(UserRow usuario)
    {
        if (usuario.RolSeleccionadoId == usuario.RolId) return;
        _savingUserId = usuario.UsuarioId;
        _error = null;
        _success = null;
        try
        {
            using var response = await Http.PatchAsync($"api/Usuarios/{usuario.UsuarioId}/rol?nuevoRolId={usuario.RolSeleccionadoId}", null);
            if (!response.IsSuccessStatusCode)
            {
                _error = await ReadErrorAsync(response);
                usuario.RolSeleccionadoId = usuario.RolId;
                return;
            }

            var role = _roles.First(r => r.RolId == usuario.RolSeleccionadoId);
            usuario.RolId = role.RolId;
            _success = $"El rol de {usuario.Nombre} {usuario.Apellido} se actualizó a {role.Nombre}.";
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
            usuario.RolSeleccionadoId = usuario.RolId;
        }
        finally
        {
            _savingUserId = null;
        }
    }

    private async Task CambiarEstadoAsync(UserRow usuario)
    {
        _savingUserId = usuario.UsuarioId;
        _error = null;
        _success = null;
        try
        {
            var action = usuario.Activo ? "desactivar" : "activar";
            using var response = await Http.PatchAsync($"api/Usuarios/{usuario.UsuarioId}/{action}", null);
            if (!response.IsSuccessStatusCode)
            {
                _error = await ReadErrorAsync(response);
                return;
            }

            usuario.Activo = !usuario.Activo;
            _success = $"La cuenta de {usuario.Nombre} {usuario.Apellido} ahora está {(usuario.Activo ? "activa" : "inactiva")}.";
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API.";
        }
        finally
        {
            _savingUserId = null;
        }
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            using var document = JsonDocument.Parse(await response.Content.ReadAsStringAsync());
            if (document.RootElement.TryGetProperty("message", out var message))
                return message.GetString() ?? "No se pudo guardar el cambio.";
            if (document.RootElement.TryGetProperty("title", out var title))
                return title.GetString() ?? "No se pudo guardar el cambio.";
            if (document.RootElement.TryGetProperty("error", out var error) && error.TryGetProperty("description", out var description))
                return description.GetString() ?? "No se pudo guardar el cambio.";
        }
        catch (JsonException) { }
        return "No se pudo guardar el cambio.";
    }

    private sealed class Envelope<T> { public Envelope() { } public T? Value { get; set; } }
    private class UserDto { public UserDto() { } public int UsuarioId { get; set; } public string Nombre { get; set; } = ""; public string Apellido { get; set; } = ""; public string? NombreUsuario { get; set; } public string? Email { get; set; } public int RolId { get; set; } public bool Activo { get; set; } }
    private sealed class RoleDto { public RoleDto() { } public int RolId { get; set; } public string Nombre { get; set; } = ""; }
    private sealed class UserRow : UserDto { public UserRow() { } public int RolSeleccionadoId { get; set; } }
    private sealed class RoleRow { public RoleRow() { } public int RolId { get; set; } public string Nombre { get; set; } = ""; }
}
