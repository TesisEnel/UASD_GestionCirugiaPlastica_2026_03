    private string NombrePaciente(ConsultaDto consulta)
    {
        if (consulta.Paciente is not null && (!string.IsNullOrWhiteSpace(consulta.Paciente.Nombre) || !string.IsNullOrWhiteSpace(consulta.Paciente.Apellido)))
            return $"{consulta.Paciente.Nombre} {consulta.Paciente.Apellido}".Trim();

        var p = _pacientes.FirstOrDefault(x => x.PacienteId == consulta.PacienteId);
        return p is null ? $"Paciente #{consulta.PacienteId}" : $"{p.Nombre} {p.Apellido}".Trim();
    }

    private string? CedulaPaciente(ConsultaDto consulta)
    {
        if (!string.IsNullOrWhiteSpace(consulta.Paciente?.Cedula))
            return consulta.Paciente!.Cedula;
        return _pacientes.FirstOrDefault(x => x.PacienteId == consulta.PacienteId)?.Cedula;
    }

    private string InicialesPaciente(ConsultaDto consulta)
    {
        var partes = NombrePaciente(consulta).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 0) return "P";
        if (partes.Length == 1) return partes[0][..1].ToUpperInvariant();
        return $"{partes[0][..1]}{partes[1][..1]}".ToUpperInvariant();
    }

    private static string ResumirTexto(string texto, int maximo)
    {
        var limpio = texto.Trim();
        return limpio.Length <= maximo ? limpio : limpio[..maximo].TrimEnd() + "…";
    }

    private static string? Limpiar(string? valor) => string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();

    private static async Task<string> ExtraerErrorAsync(HttpResponseMessage response, string fallback)
    {
        var body = await response.Content.ReadAsStringAsync();
        if (string.IsNullOrWhiteSpace(body)) return $"{fallback} (HTTP {(int)response.StatusCode}).";

        try
        {
            using var doc = JsonDocument.Parse(body);
            var root = doc.RootElement;
            if (root.ValueKind == JsonValueKind.Object)
            {
                if (TryGetProp(root, "error") is { ValueKind: JsonValueKind.Object } err)
                {
                    var desc = TryGetString(err, "description") ?? TryGetString(err, "message") ?? TryGetString(err, "code");
                    if (!string.IsNullOrWhiteSpace(desc)) return desc;
                }
                var msg = TryGetString(root, "message") ?? TryGetString(root, "detail") ?? TryGetString(root, "title");
                if (!string.IsNullOrWhiteSpace(msg)) return msg;
            }
        }
        catch (JsonException) { }

        return $"{fallback} (HTTP {(int)response.StatusCode}).";
    }

    private static JsonElement? TryGetProp(JsonElement obj, string name)
    {
        foreach (var p in obj.EnumerateObject())
            if (p.Name.Equals(name, StringComparison.OrdinalIgnoreCase))
                return p.Value;
        return null;
    }

    private static string? TryGetString(JsonElement obj, string name) =>
        TryGetProp(obj, name) is { ValueKind: JsonValueKind.String } el ? el.GetString() : null;

