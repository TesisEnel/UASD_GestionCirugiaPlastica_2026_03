@page "/registro"
@attribute [AllowAnonymous]
@inject AuthService Auth

<PageTitle>Crear cuenta | Tanger Clinic</PageTitle>

<div class="login-page registration-page">
    <EditForm Model="_form" OnValidSubmit="RegistrarAsync" class="login-card account-card">
        <div class="login-brand"><i class="fa-solid fa-heart-pulse"></i></div>
        <h1>Crear cuenta</h1>
        <p>Regístrate como paciente de Tanger Clinic</p>
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (_error is not null) { <div class="login-error" role="alert">@_error</div> }
        @if (_success) { <div class="register-success" role="status">Tu cuenta quedó registrada como Paciente. <a href="/login">Iniciar sesión</a></div> }

        <label for="register-name">Nombre completo *</label>
        <InputText id="register-name" @bind-Value="_form.NombreCompleto" autocomplete="name" maxlength="250" />

        <label for="register-username">Nombre de usuario *</label>
        <InputText id="register-username" @bind-Value="_form.NombreUsuario" autocomplete="username" maxlength="100" />

        <label for="register-password">Contraseña (mínimo 12 caracteres) *</label>
        <InputText id="register-password" type="password" @bind-Value="_form.Password" autocomplete="new-password" />

        <label for="register-email">Correo electrónico (opcional)</label>
        <InputText id="register-email" type="email" @bind-Value="_form.Email" autocomplete="email" />

        <label for="register-id">Cédula (opcional)</label>
        <InputText id="register-id" @bind-Value="_form.Cedula" maxlength="20" />

        <label for="register-phone">Teléfono (opcional)</label>
        <InputText id="register-phone" type="tel" @bind-Value="_form.Telefono" autocomplete="tel" maxlength="250" />

        <button type="submit" disabled="@_busy">@(_busy ? "Creando cuenta…" : "Crear cuenta")</button>
        <div class="login-register-link">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></div>
    </EditForm>
</div>

@code {
    private readonly RegistrationForm _form = new();
    private bool _busy;
    private bool _success;
    private string? _error;

    private async Task RegistrarAsync()
    {
        _busy = true;
        _error = null;
        _success = false;
        try
        {
            var result = await Auth.RegisterAsync(new RegisterAccountRequest(
                _form.NombreCompleto.Trim(),
                _form.NombreUsuario.Trim(),
                _form.Password,
                string.IsNullOrWhiteSpace(_form.Email) ? null : _form.Email.Trim(),
                string.IsNullOrWhiteSpace(_form.Cedula) ? null : _form.Cedula.Trim(),
                string.IsNullOrWhiteSpace(_form.Telefono) ? null : _form.Telefono.Trim()));
            _success = result.Success;
            if (!result.Success) _error = result.Message;
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo conectar con la API. Verifica que esté en ejecución.";
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class RegistrationForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ingresa tu nombre completo.")]
        [System.ComponentModel.DataAnnotations.StringLength(250)]
        public string NombreCompleto { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Elige un nombre de usuario.")]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 3)]
        [System.ComponentModel.DataAnnotations.RegularExpression(@"^[\p{L}\p{N}._-]+$", ErrorMessage = "Usa letras, números, punto, guion o guion bajo, sin espacios.")]
        public string NombreUsuario { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ingresa una contraseña.")]
        [System.ComponentModel.DataAnnotations.MinLength(12, ErrorMessage = "La contraseña debe tener al menos 12 caracteres.")]
        public string Password { get; set; } = "";

        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Ingresa un correo válido.")]
        [System.ComponentModel.DataAnnotations.StringLength(250)]
        public string? Email { get; set; }

        [System.ComponentModel.DataAnnotations.StringLength(20)]
        public string? Cedula { get; set; }

        [System.ComponentModel.DataAnnotations.StringLength(250)]
        public string? Telefono { get; set; }
    }
}
