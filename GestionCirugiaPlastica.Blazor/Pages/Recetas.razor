@page "/recetas"
@attribute [Authorize(Roles = "Doctora,AsistenteClinico")]
@inject HttpClient Http

<PageTitle>Recetas | Tanger Clinic</PageTitle>
<div class="med-page">
    <header class="med-page-header">
        <div><h1>Recetas médicas</h1><p>Medicamentos e indicaciones para tus pacientes</p></div>
        <button class="med-primary" @onclick="Nueva">Redactar receta</button>
    </header>
    @if (_error is not null) { <div class="med-error" role="alert">@_error</div> }
    <div class="med-filters">
        <input class="med-search" placeholder="Filtrar por paciente o medicamento" @bind="_buscar" @bind:event="oninput" />
        <select @bind="_pacienteFiltro"><option value="0">Todos los pacientes</option>@foreach (var p in _pacientes) { <option value="@p.PacienteId">@p.Nombre @p.Apellido</option> }</select>
    </div>

    @if (_form is not null)
    {
        <section class="med-card">
            <h2>@(_form.RecetaId == 0 ? "Nueva receta" : "Editar receta")</h2>
            <EditForm Model="_form" OnValidSubmit="GuardarAsync">
                <div class="med-grid">
                    <label>Paciente<select @bind="_form.PacienteId"><option value="0">Selecciona paciente</option>@foreach (var p in _pacientes) { <option value="@p.PacienteId">@p.Nombre @p.Apellido</option> }</select></label>
                    <label>Fecha<InputDate @bind-Value="_form.Fecha" /></label>
                    <label class="med-span">Indicaciones médicas / postoperatorias<InputTextArea @bind-Value="_form.Indicaciones" /></label>
                </div>
                <h3>Medicamentos</h3>
                @for (var i = 0; i < _form.DetallesReceta.Count; i++)
                {
                    var detail = _form.DetallesReceta[i];
                    <div class="receta-detail">
                        <label>Medicamento<InputText @bind-Value="detail.Medicamento" /></label>
                        <label>Dosis<InputText @bind-Value="detail.Dosis" /></label>
                        <label>Frecuencia<InputText @bind-Value="detail.Frecuencia" /></label>
                        <label>Duración<InputText @bind-Value="detail.Duracion" /></label>
                        <label>Instrucciones<InputText @bind-Value="detail.Instrucciones" /></label>
                    </div>
                }
                <button type="button" class="med-secondary" @onclick="AgregarMedicamento">Agregar medicamento</button>
                @if (_formError is not null) { <p class="med-error">@_formError</p> }
                <div class="med-form-actions"><button class="med-primary" type="submit" disabled="@_saving">@(_saving ? "Guardando…" : "Guardar receta")</button><button class="med-secondary" type="button" @onclick="Cancelar">Cancelar</button></div>
            </EditForm>
        </section>
    }

    @foreach (var receta in RecetasVisibles)
    {
        <article class="med-card receta-card">
            <header><div><span>@receta.Fecha.ToString("dd/MM/yyyy")</span><h2>@NombrePaciente(receta.PacienteId)</h2></div><button class="med-secondary" @onclick="() => Editar(receta)">Editar receta</button></header>
            <p>@receta.Indicaciones</p>
            <div class="receta-drugs">
                @foreach (var d in receta.DetallesReceta) { <div><strong>@d.Medicamento</strong><span>@d.Dosis · @d.Frecuencia · @d.Duracion</span><small>@d.Instrucciones</small></div> }
            </div>
        </article>
    }
    @if (_recetas.Count == 0) { <section class="med-card">Todavía no hay recetas registradas.</section> }
</div>

@code {
    private List<RecetaDto> _recetas = new();
    private List<PacienteDto> _pacientes = new();
    private RecetaForm? _form;
    private string _buscar = "";
    private int _pacienteFiltro;
    private string? _error, _formError;
    private bool _saving;
    private IEnumerable<RecetaDto> RecetasVisibles => _recetas.Where(r => (_pacienteFiltro == 0 || r.PacienteId == _pacienteFiltro) && (string.IsNullOrWhiteSpace(_buscar) || $"{NombrePaciente(r.PacienteId)} {string.Join(" ", r.DetallesReceta.Select(d => d.Medicamento))}".Contains(_buscar, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var pTask = Http.GetFromJsonAsync<Envelope<List<PacienteDto>>>("api/Pacientes/expediente/selector");
            var rTask = Http.GetFromJsonAsync<Envelope<List<RecetaDto>>>("api/Recetas");
            await Task.WhenAll(pTask, rTask);
            _pacientes = (await pTask)?.Value ?? new();
            _recetas = (await rTask)?.Value ?? new();
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException) { _error = "No se pudieron cargar pacientes y recetas."; }
    }

    private string NombrePaciente(int id) { var p = _pacientes.FirstOrDefault(x => x.PacienteId == id); return p is null ? $"Paciente #{id}" : $"{p.Nombre} {p.Apellido}"; }
    private void Nueva() { _formError = null; _form = new RecetaForm { Fecha = DateTime.Today, DetallesReceta = [new()] }; }
    private void Editar(RecetaDto receta) => _form = new RecetaForm { RecetaId = receta.RecetaId, PacienteId = receta.PacienteId, Fecha = receta.Fecha, Indicaciones = receta.Indicaciones, ConsultaId = receta.ConsultaId, CirugiaId = receta.CirugiaId, DetallesReceta = receta.DetallesReceta.Select(d => new DetalleForm { DetalleRecetaId = d.DetalleRecetaId, Medicamento = d.Medicamento, Dosis = d.Dosis, Frecuencia = d.Frecuencia, Duracion = d.Duracion, Instrucciones = d.Instrucciones }).ToList() };
    private void AgregarMedicamento() => _form?.DetallesReceta.Add(new());
    private void Cancelar() { _form = null; _formError = null; }

    private async Task GuardarAsync()
    {
        if (_form is null) return;
        if (_form.PacienteId <= 0 || _form.DetallesReceta.Count == 0 || _form.DetallesReceta.Any(d => string.IsNullOrWhiteSpace(d.Medicamento))) { _formError = "Selecciona un paciente e ingresa al menos un medicamento."; return; }
        _saving = true; _formError = null;
        var request = new { _form.RecetaId, _form.Fecha, _form.PacienteId, _form.ConsultaId, _form.CirugiaId, _form.Indicaciones, DetallesReceta = _form.DetallesReceta };
        try
        {
            using var response = await Http.PostAsJsonAsync("api/Recetas", request);
            if (!response.IsSuccessStatusCode) { _formError = "No se pudo guardar la receta. Revisa el paciente, las indicaciones y los medicamentos."; return; }
            _form = null;
            _recetas = (await Http.GetFromJsonAsync<Envelope<List<RecetaDto>>>("api/Recetas"))?.Value ?? new();
        }
        catch (HttpRequestException) { _formError = "No se pudo conectar con la API."; }
        finally { _saving = false; }
    }

    private sealed class Envelope<T> { public T? Value { get; set; } }
    private sealed class PacienteDto { public int PacienteId { get; set; } public string Nombre { get; set; } = ""; public string Apellido { get; set; } = ""; }
    private sealed class RecetaDto { public int RecetaId { get; set; } public DateTime Fecha { get; set; } public int PacienteId { get; set; } public int? ConsultaId { get; set; } public int? CirugiaId { get; set; } public string? Indicaciones { get; set; } public List<DetalleDto> DetallesReceta { get; set; } = new(); }
    private sealed class DetalleDto { public int DetalleRecetaId { get; set; } public string Medicamento { get; set; } = ""; public string? Dosis { get; set; } public string? Frecuencia { get; set; } public string? Duracion { get; set; } public string? Instrucciones { get; set; } }
    private sealed class RecetaForm { public int RecetaId { get; set; } public DateTime Fecha { get; set; } public int PacienteId { get; set; } public int? ConsultaId { get; set; } public int? CirugiaId { get; set; } public string? Indicaciones { get; set; } public List<DetalleForm> DetallesReceta { get; set; } = new(); }
    private sealed class DetalleForm { public int DetalleRecetaId { get; set; } public string Medicamento { get; set; } = ""; public string? Dosis { get; set; } public string? Frecuencia { get; set; } public string? Duracion { get; set; } public string? Instrucciones { get; set; } }
}
