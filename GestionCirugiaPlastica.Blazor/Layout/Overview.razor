@inject IJSRuntime JS
@inject HttpClient Http
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IAsyncDisposable
@using System.Net.Http.Json

<div class="overview-container">

    <!-- ENCABEZADO -->
    <div class="overview-heading">
        <div>
            <h1>Resumen del Consultorio</h1>
            <p>Consulta la actividad y el rendimiento de tu consultorio</p>
        </div>

        <button class="date-filter" type="button">
            <i class="fa-regular fa-calendar"></i>
            @DateTime.Today.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-DO"))
            <i class="fa-solid fa-chevron-down"></i>
        </button>
    </div>

    @if (_error is not null) { <div class="overview-error" role="alert">@_error</div> }
    @if (_loading) { <p class="overview-loading">Cargando resumen...</p> }

    <!-- FILA PRINCIPAL -->
    <div class="overview-main-grid">

        <!-- INGRESOS -->
        <section class="revenue-card">

            <div class="revenue-header">
                <div>
                    <h3>Ingresos</h3>
                    <p>Pagos registrados como cobrados durante el mes</p>
                </div>

                <i class="fa-solid fa-ellipsis"></i>
            </div>

            <div class="revenue-chart">
                <canvas id="revenueChart"></canvas>

                <div class="revenue-chart-center">
                    <span>Ingresos cobrados este mes</span>
                    <strong>RD$ @IngresosDelMes.ToString("N0")</strong>
                </div>
            </div>

            <div class="revenue-breakdown">

                <div class="revenue-row">
                    <span>
                        <i class="revenue-dot salary-dot"></i>
                        Otros cobros
                    </span>
                    <strong>RD$ @OtrosIngresos.ToString("N0")</strong>
                </div>

                <div class="revenue-row">
                    <span>
                        <i class="revenue-dot consultation-dot"></i>
                        Citas
                    </span>
                    <strong>RD$ @IngresosCitas.ToString("N0")</strong>
                </div>

                <div class="revenue-row">
                    <span>
                        <i class="revenue-dot surgery-dot"></i>
                        Cirugías
                    </span>
                    <strong>RD$ @IngresosCirugias.ToString("N0")</strong>
                </div>

                @if (_esDoctora)
                {
                    <div class="revenue-row"><span><i class="revenue-dot expense-dot"></i>Gastos registrados</span><strong>RD$ @_gastosDelMes.ToString("N0")</strong></div>
                }

            </div>
        </section>

        <!-- INDICADORES Y TABLA -->
        <div class="overview-right-content">

            <div class="overview-kpi-grid">

                <div class="kpi-card">
                    <div class="kpi-top">
                        <span>Total de pacientes</span>
                        <div class="kpi-icon patients-kpi-icon">
                            <i class="fa-solid fa-users"></i>
                        </div>
                    </div>

                    <h2>@_pacientes.Count</h2>

                    <span class="kpi-growth">
                        @_pacientes.Count(p => p.FechaRegistro.Year == DateTime.Today.Year && p.FechaRegistro.Month == DateTime.Today.Month) nuevos este mes
                    </span>
                </div>

                <div class="kpi-card">
                    <div class="kpi-top">
                        <span>Citas próximas</span>
                        <div class="kpi-icon new-patients-kpi-icon">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>
                    </div>

                    <h2>@CitasProximas</h2>

                    <span class="kpi-growth">
                        @_citas.Count(c => c.Fecha.Date == DateTime.Today && !EsCancelada(c.Estado)) citas hoy
                    </span>
                </div>

                <div class="kpi-card">
                    <div class="kpi-top"><span>Ingresos cobrados este mes</span><div class="kpi-icon revenue-kpi-icon"><i class="fa-solid fa-wallet"></i></div></div>
                    <h2>RD$ @IngresosDelMes.ToString("N0")</h2>
                    <span class="kpi-growth">Pagos con estado Pagado</span>
                </div>

            </div>

            <!-- TABLA DE PACIENTES -->
            <section class="dashboard-card patients-section">

                <div class="section-heading">
                    <div>
                        <h3>Pacientes recientes</h3>
                        <p>Pacientes recientes y su última actividad</p>
                    </div>

                    <a href="/pacientes">Ver todos</a>
                </div>

                <div class="table-responsive">
                    <table class="patients-table">

                        <thead>
                            <tr>
                                <th>N.º</th>
                                <th>Nombre</th>
                                <th>Edad</th>
                                <th>Última actividad</th>
                                <th>Motivo</th>
                                <th>Contacto</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (!Patients.Any())
                            {
                                <tr><td colspan="6">No hay pacientes registrados todavía.</td></tr>
                            }
                            @foreach (var patient in Patients)
                            {
                                <tr>
                                    <td>@patient.Id</td>

                                    <td>
                                        <div class="patient-info">
                                            <div class="patient-avatar">
                                                @patient.Initials
                                            </div>

                                            <strong>@patient.Name</strong>
                                        </div>
                                    </td>

                                    <td>@(patient.Age?.ToString() ?? "—")</td>
                                    <td>@patient.DateTime</td>
                                    <td>@patient.Reason</td>

                                    <td>@patient.Contact</td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </section>

        </div>
    </div>

    <!-- GRÁFICOS INFERIORES -->
    <div class="charts-grid">

        <!-- DISTRIBUCIÓN DE PACIENTES -->
        <section class="dashboard-card chart-card">

            <div class="section-heading">
                <div>
                    <h3>Pacientes</h3>
                    <p>Distribución de pacientes</p>
                </div>
            </div>

            <div class="chart-legend">
                <span>
                    <i class="legend-dot male-dot"></i>
                    Masculino (@_pacientes.Count(p => EsGenero(p.Sexo, "Masculino")))
                </span>

                <span>
                    <i class="legend-dot female-dot"></i>
                    Femenino (@_pacientes.Count(p => EsGenero(p.Sexo, "Femenino")))
                </span>
            </div>

            <div class="chart-placeholder">
                <canvas id="patientsChart"></canvas>
            </div>

        </section>

        <!-- ACTIVIDAD DEL CONSULTORIO -->
        <section class="dashboard-card chart-card">

            <div class="section-heading">
                <div>
                    <h3>Actividad del consultorio</h3>
                    <p>Citas registradas durante los últimos siete días</p>
                </div>
            </div>

            <div class="chart-legend">
                <span>
                    <i class="legend-dot online-dot"></i>
                    Citas
                </span>
            </div>

            <div class="chart-placeholder">
                <canvas id="activityChart"></canvas>
            </div>

        </section>

    </div>

</div>

@code {

    private IJSObjectReference? chartManager;
    private List<PacienteDto> _pacientes = new();
    private List<CitaDto> _citas = new();
    private List<PagoDto> _pagos = new();
    private decimal _gastosDelMes;
    private bool _loading = true;
    private bool _esDoctora;
    private bool _chartsNeedUpdate = true;
    private string? _error;

    private IEnumerable<PatientItem> Patients => _pacientes
        .OrderByDescending(p => p.FechaRegistro)
        .Take(5)
        .Select(p =>
        {
            var ultimaCita = _citas.Where(c => c.PacienteId == p.PacienteId).OrderByDescending(c => c.Fecha).FirstOrDefault();
            var actividad = ultimaCita?.Fecha ?? p.FechaRegistro;
            return new PatientItem
            {
                Id = p.PacienteId.ToString(),
                Name = $"{p.Nombre} {p.Apellido}".Trim(),
                Initials = $"{p.Nombre.FirstOrDefault()}{p.Apellido.FirstOrDefault()}".ToUpperInvariant(),
                Age = p.FechaNacimiento.HasValue ? CalcularEdad(p.FechaNacimiento.Value) : null,
                DateTime = actividad.ToString("dd MMM yyyy HH:mm", new System.Globalization.CultureInfo("es-DO")),
                Reason = ultimaCita?.TipoCita ?? "Paciente registrado",
                Contact = p.Telefono ?? p.Email ?? "—"
            };
        });

    private int CitasProximas => _citas.Count(c => c.Fecha >= DateTime.Today && !EsCancelada(c.Estado));
    private decimal IngresosDelMes => PagosDelMes.Sum(p => p.Monto);
    private IEnumerable<PagoDto> PagosDelMes => _pagos.Where(p => p.Estado.Equals("Pagado", StringComparison.OrdinalIgnoreCase)
        && p.Fecha.Year == DateTime.Today.Year && p.Fecha.Month == DateTime.Today.Month);
    private decimal IngresosCirugias => PagosDelMes.Where(p => p.CirugiaId.HasValue).Sum(p => p.Monto);
    private decimal IngresosCitas => PagosDelMes.Where(p => p.CitaId.HasValue && !p.CirugiaId.HasValue).Sum(p => p.Monto);
    private decimal OtrosIngresos => PagosDelMes.Where(p => !p.CitaId.HasValue && !p.CirugiaId.HasValue).Sum(p => p.Monto);
    private double[] DistribucionIngresos => [(double)OtrosIngresos, (double)IngresosCitas, (double)IngresosCirugias];
    private int[] DistribucionSexo =>
    [
        _pacientes.Count(p => EsGenero(p.Sexo, "Masculino")),
        _pacientes.Count(p => EsGenero(p.Sexo, "Femenino"))
    ];
    private string[] DiasSemana => Enumerable.Range(0, 7).Reverse().Select(offset => DateTime.Today.AddDays(-offset).ToString("ddd", new System.Globalization.CultureInfo("es-DO"))).ToArray();
    private int[] CitasUltimosSieteDias => Enumerable.Range(0, 7).Reverse()
        .Select(offset => DateTime.Today.AddDays(-offset).Date)
        .Select(dia => _citas.Count(c => DateTime.SpecifyKind(c.Fecha, DateTimeKind.Local).Date == dia && !EsCancelada(c.Estado)))
        .ToArray();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _esDoctora = auth.User.IsInRole("Doctora");
            var pacientesTask = Http.GetFromJsonAsync<Envelope<List<PacienteDto>>>("api/Pacientes");
            var citasTask = Http.GetFromJsonAsync<Envelope<List<CitaDto>>>("api/Citas");
            var pagosTask = Http.GetFromJsonAsync<Envelope<List<PagoDto>>>("api/Pagos");
            await Task.WhenAll(pacientesTask, citasTask, pagosTask);
            _pacientes = (await pacientesTask)?.Value ?? new();
            _citas = (await citasTask)?.Value ?? new();
            _pagos = (await pagosTask)?.Value ?? new();

            if (_esDoctora)
            {
                var gastos = await Http.GetFromJsonAsync<Envelope<List<GastoDto>>>("api/Gastos");
                _gastosDelMes = (gastos?.Value ?? new())
                    .Where(g => g.Fecha.Year == DateTime.Today.Year && g.Fecha.Month == DateTime.Today.Month)
                    .Sum(g => g.Monto);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _error = "No se pudo cargar la información del resumen desde la API.";
        }
        finally { _loading = false; _chartsNeedUpdate = true; }
    }

    // Cargar las gráficas después de mostrar el componente
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            chartManager = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/charts.js");
        }

        if (chartManager is not null && _chartsNeedUpdate)
        {
            await chartManager.InvokeVoidAsync("createRevenueChart", DistribucionIngresos);
            await chartManager.InvokeVoidAsync("createPatientsChart", DistribucionSexo);
            await chartManager.InvokeVoidAsync("createActivityChart", DiasSemana, CitasUltimosSieteDias);
            _chartsNeedUpdate = false;
        }
    }

    // Liberar recursos de JavaScript
    public async ValueTask DisposeAsync()
    {
        if (chartManager is not null)
        {
            await chartManager.DisposeAsync();
        }
    }

    private class PatientItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Initials { get; set; } = "";
        public int? Age { get; set; }
        public string DateTime { get; set; } = "";
        public string Reason { get; set; } = "";
        public string Contact { get; set; } = "";
    }

    private static int CalcularEdad(DateOnly nacimiento)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        var edad = hoy.Year - nacimiento.Year;
        if (nacimiento > hoy.AddYears(-edad)) edad--;
        return edad;
    }

    private static bool EsCancelada(string? estado) => estado?.Contains("cancel", StringComparison.OrdinalIgnoreCase) == true;
    private static bool EsGenero(string? sexo, string genero) => string.Equals(sexo?.Trim(), genero, StringComparison.OrdinalIgnoreCase);

    private sealed class Envelope<T> { public T? Value { get; set; } }
    private sealed class PacienteDto { public int PacienteId { get; set; } public DateTime FechaRegistro { get; set; } public string Nombre { get; set; } = ""; public string Apellido { get; set; } = ""; public DateOnly? FechaNacimiento { get; set; } public string? Sexo { get; set; } public string? Telefono { get; set; } public string? Email { get; set; } }
    private sealed class CitaDto { public int CitaId { get; set; } public int PacienteId { get; set; } public DateTime Fecha { get; set; } public string? TipoCita { get; set; } public string Estado { get; set; } = ""; }
    private sealed class PagoDto { public int PagoId { get; set; } public DateTime Fecha { get; set; } public int? CitaId { get; set; } public int? CirugiaId { get; set; } public decimal Monto { get; set; } public string Estado { get; set; } = ""; }
    private sealed class GastoDto { public DateTime Fecha { get; set; } public decimal Monto { get; set; } }
}
