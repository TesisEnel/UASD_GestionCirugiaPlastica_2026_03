
@page "/citas"
@attribute [Authorize(Roles = "Doctora,Secretaria")]
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Citas | Tanger Clinic</PageTitle>

<div class="appointments-page">

    <!-- ENCABEZADO -->
    <div class="appointments-header">
        <div>
            <h2>Gestión de citas</h2>
            <p>Administra las citas y consultas de tus pacientes.</p>
        </div>

        <button class="btn-primary-custom" @onclick="ToggleForm">
            @(ShowForm ? "Cerrar formulario" : "+ Nueva cita")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger">@ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success">@SuccessMessage</div>
    }

    <!-- ESTADÍSTICAS -->
    <div class="appointment-stats">

        <div class="appointment-stat-card">
            <div class="appointment-stat-icon">📅</div>
            <div>
                <h3>@AppointmentList.Count</h3>
                <p>Total de citas</p>
            </div>
        </div>

        <div class="appointment-stat-card">
            <div class="appointment-stat-icon">✓</div>
            <div>
                <h3>@AppointmentList.Count(a => a.Status == "Llegó")</h3>
                <p>En sala de espera</p>
            </div>
        </div>

        <div class="appointment-stat-card">
            <div class="appointment-stat-icon">◷</div>
            <div>
                <h3>@AppointmentList.Count(a => a.Status is "Atendida" or "Completada")</h3>
                <p>Atendidas</p>
            </div>
        </div>

        <div class="appointment-stat-card">
            <div class="appointment-stat-icon">×</div>
            <div>
                <h3>@AppointmentList.Count(a => a.Status == "Cancelada")</h3>
                <p>Canceladas</p>
            </div>
        </div>

    </div>

    <!-- FORMULARIO DE NUEVA CITA -->
    @if (ShowForm)
    {
        <div class="appointments-panel appointment-form">

            <h3>@(EditingCitaId == 0 ? "Nueva cita" : "Editar cita")</h3>

            <div class="appointment-form-group">
                <label>Paciente</label>
                @if (Patients.Count == 0)
                {
                    <p>No hay pacientes registrados. Registra uno aquí; el correo es opcional.</p>
                }
                else
                {
                    <select class="form-select" @bind="NewPatientId">
                        <option value="0">Selecciona un paciente</option>
                        @foreach (var patient in Patients.OrderBy(p => p.Nombre).ThenBy(p => p.Apellido))
                        {
                            <option value="@patient.PacienteId">@patient.Nombre @patient.Apellido</option>
                        }
                    </select>
                }
                @if (EditingCitaId == 0)
                {
                    <button type="button" class="btn-secondary-custom" @onclick="TogglePatientForm">
                        @(ShowPatientForm ? "Cerrar registro de paciente" : "+ Registrar paciente nuevo")
                    </button>
                }
            </div>

            @if (ShowPatientForm)
            {
                <section class="appointment-form-group quick-patient-form">
                    <h4>Registro rápido de paciente</h4>
                    <div class="appointment-form-grid">
                        <label>Nombre *<input class="form-control" @bind="NewPatientName" /></label>
                        <label>Apellido *<input class="form-control" @bind="NewPatientSurname" /></label>
                        <label>Cédula (opcional)<input class="form-control" @bind="NewPatientCedula" /></label>
                        <label>Teléfono (opcional)<input class="form-control" @bind="NewPatientPhone" /></label>
                        <label>Correo electrónico (opcional)<input class="form-control" @bind="NewPatientEmail" /></label>
                        <label class="quick-insurance-check"><input class="quick-insurance-toggle" type="checkbox" @bind="NewPatientTieneSeguro" /> Tiene seguro médico</label>
                        @if (NewPatientTieneSeguro)
                        {
                            <label>Aseguradora (opcional)
                                <select class="form-select" @bind="NewPatientSeguroId">
                                    <option value="0">Sin aseguradora vinculada</option>
                                    @foreach (var seguro in InsuranceCompanies)
                                    {
                                        <option value="@seguro.SeguroId">@seguro.Nombre</option>
                                    }
                                </select>
                            </label>
                            <label>Número de póliza (opcional)<input class="form-control" @bind="NewPatientNumeroPoliza" /></label>
                        }
                    </div>
                    <button type="button" class="btn-primary-custom" @onclick="CrearPacienteAsync" disabled="@IsCreatingPatient">
                        @(IsCreatingPatient ? "Registrando..." : "Registrar y seleccionar paciente")
                    </button>
                </section>
            }

                <div class="appointment-form-group">
                    <label>Motivo / tipo de cita</label>
                    <input type="text" class="form-control" maxlength="250" placeholder="Consulta, evaluación, seguimiento..." @bind="NewType" />
                </div>

                <div class="appointment-form-group">
                    <label>Fecha y hora</label>
                    <input type="datetime-local" class="form-control" step="60" @bind="NewDateTime" @bind:format="yyyy-MM-ddTHH:mm" />
                </div>

                @if (EditingCitaId != 0)
                {
                    <div class="appointment-form-group">
                        <label>Estado de la cita</label>
                        <select class="form-select" @bind="NewStatus">
                            @foreach (var status in AppointmentStatuses) { <option value="@status">@status</option> }
                        </select>
                    </div>
                }

                <div class="appointment-form-group">
                    <label>Costo (RD$)</label>

                    <input type="number"
                           class="form-control"
                           min="0"
                           step="0.01"
                           @bind="NewCost" />
                </div>

                <div class="appointment-form-group appointment-form-full">
                    <label>Observaciones</label>

                    <textarea class="form-control"
                              rows="3"
                              @bind="NewObservations"></textarea>
                </div>

                <div class="appointment-actions">

                    <button class="btn-primary-custom"
                            @onclick="SaveAppointment"
                            disabled="@IsSaving">

                        @(IsSaving ? "Guardando..." : "Guardar cita")

                    </button>

                    <button class="btn-secondary-custom"
                            @onclick="ToggleForm">
                        Cancelar
                    </button>

                </div>
        </div>
    }

    <!-- LISTADO DE CITAS -->
    <div class="appointments-panel">

        <div class="appointments-toolbar">

            <input class="appointments-search"
                   type="search"
                   placeholder="Buscar paciente..."
                   @bind="SearchText"
                   @bind:event="oninput" />

                    <select class="form-select"
                            style="max-width: 220px;"
                            @bind="SelectedStatus">

                <option value="Todas">Todos los estados</option>
                <option value="Llegó">En sala de espera / Llegó</option>
                <option value="Atendida">Atendidas</option>
                <option value="Confirmada">Confirmadas</option>
                <option value="Pendiente">Pendientes</option>
                <option value="Cancelada">Canceladas</option>
                <option value="Completada">Completadas</option>

            </select>

        </div>

        @if (IsLoading)
        {
            <p>Cargando citas...</p>
        }
        else if (FilteredAppointments.Count == 0)
        {
            <p>No hay citas para mostrar.</p>
        }
        else
        {
            <div class="appointments-table-container">

                <table class="appointments-table">

                    <thead>
                        <tr>
                            <th>Paciente</th>
                            <th>Tipo de cita</th>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Costo</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var appointment in FilteredAppointments)
                        {
                            <tr>
                                <td>@appointment.Patient</td>

                                <td>@appointment.Type</td>

                                <td>
                                    @appointment.Date.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @appointment.Date.ToString("hh:mm tt")
                                </td>

                                <td>
                                    <div class="appointment-cost-editor">
                                        <span>RD$</span>
                                        <input type="number" min="0" step="0.01" @bind="appointment.EditedCost" />
                                        <button class="btn-secondary-custom" @onclick="() => UpdateAppointmentCost(appointment)" disabled="@IsSaving">Guardar costo</button>
                                    </div>
                                </td>

                                <td>
                                    <span class="appointment-status @GetStatusClass(appointment.Status)">
                                        @appointment.Status
                                    </span>
                                </td>

                                <td>
                                    <select class="form-select"
                                            value="@appointment.Status"
                                            disabled="@IsUpdatingStatus"
                                            @onchange="(e) => UpdateAppointmentStatus(appointment, e.Value?.ToString())">

                                        <option value="Pendiente">Pendiente</option>
                                        <option value="Llegó">En sala de espera / Llegó</option>
                                        <option value="Atendida">Atendida</option>
                                        <option value="Confirmada">Confirmada</option>
                                        <option value="Completada">Completada</option>
                                        <option value="Cancelada">Cancelada</option>

                                    </select>
                                    <button type="button" class="btn-secondary-custom appointment-edit-button" @onclick="() => EditAppointment(appointment)">Editar cita</button>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

@code {

    private static readonly string[] AppointmentStatuses = ["Pendiente", "Llegó", "Atendida", "Cancelada", "Confirmada", "Completada"];

    // LISTAS
    private List<AppointmentItem> AppointmentList = new();
    private List<PatientItem> Patients = new();
    private List<InsuranceItem> InsuranceCompanies = new();

    // ESTADOS
    private bool ShowForm;
    private bool IsLoading = true;
    private bool IsSaving;
    private bool IsUpdatingStatus;
    private bool ShowPatientForm;
    private bool IsCreatingPatient;
    private bool NewPatientTieneSeguro;
    private int NewPatientSeguroId;

    // FORMULARIO
    private int EditingCitaId;
    private int NewPatientId;
    private string NewType = "";
    private DateTime NewDateTime = DateTime.Today.AddDays(1).AddHours(9);
    private string NewStatus = "Pendiente";
    private string EstadoPagoActual = "Pendiente";
    private int? CitaAnteriorActual;

    private decimal NewCost;
    private string NewObservations = "";
    private string NewPatientName = "";
    private string NewPatientSurname = "";
    private string NewPatientCedula = "";
    private string NewPatientPhone = "";
    private string NewPatientEmail = "";
    private string NewPatientNumeroPoliza = "";

    // BÚSQUEDA Y FILTROS
    private string SearchText = "";
    private string SelectedStatus = "Todas";

    // MENSAJES
    private string ErrorMessage = "";
    private string SuccessMessage = "";

    // CITAS FILTRADAS
    private List<AppointmentItem> FilteredAppointments =>
        AppointmentList
            .Where(a => a.Patient.Contains(
                SearchText ?? "",
                StringComparison.OrdinalIgnoreCase))
            .Where(a => SelectedStatus == "Todas" ||
                        a.Status == SelectedStatus)
            .OrderBy(a => a.Date)
            .ToList();

    // INICIALIZACIÓN
    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
        await LoadInsuranceCompanies();
        await LoadAppointments();
    }

    private async Task LoadInsuranceCompanies()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<ApiResult<List<InsuranceItem>>>("api/Seguros/activos");
            InsuranceCompanies = result?.Value ?? new();
        }
        catch (Exception ex) { ErrorMessage = "No fue posible cargar las aseguradoras: " + ex.Message; }
    }

    // CARGAR PACIENTES DESDE LA API
    private async Task LoadPatients()
    {
        try
        {
            var response =
                await Http.GetFromJsonAsync<ApiResult<List<PatientItem>>>(
                    "api/Pacientes");

            Patients = response?.Value ?? new();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "No fue posible cargar los pacientes: " + ex.Message;
        }
    }

    // CARGAR CITAS DESDE LA API
    private async Task LoadAppointments()
    {
        IsLoading = true;

        try
        {
            var response =
                await Http.GetFromJsonAsync<ApiResult<List<AppointmentDto>>>(
                    "api/Citas");

            AppointmentList = (response?.Value ?? new())
                .Select(c => new AppointmentItem
                {
                    CitaId = c.CitaId,
                    PacienteId = c.PacienteId,

                    Patient = c.Paciente != null
                        ? $"{c.Paciente.Nombre} {c.Paciente.Apellido}"
                        : "Paciente #" + c.PacienteId,

                    Type = c.TipoCita ?? "Sin especificar",

                    Date = c.Fecha,

                    Status = c.Estado,

                    Cost = c.Costo,
                    EditedCost = c.Costo,
                    PaymentStatus = c.EstadoPago ?? "Pendiente",
                    Observations = c.Observaciones ?? "",
                    EstadoPago = c.EstadoPago ?? "Pendiente",
                    CitaAnteriorId = c.CitaAnteriorId
                })
                .ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "No fue posible cargar las citas: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task UpdateAppointmentCost(AppointmentItem appointment)
    {
        ErrorMessage = "";
        SuccessMessage = "";
        if (appointment.EditedCost < 0)
        {
            ErrorMessage = "El costo no puede ser negativo.";
            appointment.EditedCost = appointment.Cost;
            return;
        }

        IsSaving = true;
        try
        {
            var cita = new
            {
                CitaId = appointment.CitaId,
                Fecha = appointment.Date,
                PacienteId = appointment.PacienteId,
                TipoCita = appointment.Type,
                Costo = appointment.EditedCost,
                Estado = appointment.Status,
                EstadoPago = appointment.PaymentStatus,
                Observaciones = appointment.Observations,
                CitaAnteriorId = appointment.CitaAnteriorId
            };

            var response = await Http.PostAsJsonAsync("api/Citas", cita);
            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "No se pudo actualizar el costo. " + await response.Content.ReadAsStringAsync();
                appointment.EditedCost = appointment.Cost;
                return;
            }

            SuccessMessage = "El costo se actualizó y el saldo pendiente fue recalculado.";
            await LoadAppointments();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error al actualizar el costo: " + ex.Message;
            appointment.EditedCost = appointment.Cost;
        }
        finally
        {
            IsSaving = false;
        }
    }

    // MOSTRAR U OCULTAR FORMULARIO
    private void ToggleForm()
    {
        if (ShowForm)
        {
            ShowForm = false;
            ResetForm();
        }
        else
        {
            ResetForm();
            ShowForm = true;
        }
        ErrorMessage = "";
        SuccessMessage = "";
    }

    private void EditAppointment(AppointmentItem appointment)
    {
        EditingCitaId = appointment.CitaId;
        NewPatientId = appointment.PacienteId;
        NewType = appointment.Type == "Sin especificar" ? "" : appointment.Type;
        NewDateTime = appointment.Date;
        NewCost = appointment.Cost;
        NewStatus = appointment.Status;
        NewObservations = appointment.Observations;
        EstadoPagoActual = appointment.EstadoPago;
        CitaAnteriorActual = appointment.CitaAnteriorId;
        ShowPatientForm = false;
        ShowForm = true;
        ErrorMessage = "";
        SuccessMessage = "";
    }

    private void TogglePatientForm()
    {
        ShowPatientForm = !ShowPatientForm;
        ErrorMessage = "";
        SuccessMessage = "";
    }

    private async Task CrearPacienteAsync()
    {
        ErrorMessage = "";
        SuccessMessage = "";
        if (string.IsNullOrWhiteSpace(NewPatientName) || string.IsNullOrWhiteSpace(NewPatientSurname))
        {
            ErrorMessage = "El nombre y el apellido del paciente son obligatorios.";
            return;
        }

        IsCreatingPatient = true;
        try
        {
            var cedula = Limpiar(NewPatientCedula);
            var telefono = Limpiar(NewPatientPhone);
            var email = Limpiar(NewPatientEmail);
            var payload = new
            {
                FechaRegistro = DateTime.Now,
                Nombre = NewPatientName.Trim(),
                Apellido = NewPatientSurname.Trim(),
                Cedula = cedula,
                Telefono = telefono,
                Email = email,
                TieneSeguro = NewPatientTieneSeguro
            };

            using var response = await Http.PostAsJsonAsync("api/Pacientes", payload);
            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "No se pudo registrar el paciente. " + await response.Content.ReadAsStringAsync();
                return;
            }

            var idsAnteriores = Patients.Select(p => p.PacienteId).ToHashSet();
            await LoadPatients();
            var pacienteCreado = Patients.FirstOrDefault(p => !idsAnteriores.Contains(p.PacienteId))
                ?? Patients.Where(p => p.Nombre.Equals(payload.Nombre, StringComparison.OrdinalIgnoreCase)
                    && p.Apellido.Equals(payload.Apellido, StringComparison.OrdinalIgnoreCase)
                    && p.Telefono == telefono)
                    .OrderByDescending(p => p.PacienteId)
                    .FirstOrDefault();

            if (pacienteCreado is null)
            {
                ErrorMessage = "El paciente se registró, pero no se pudo seleccionar automáticamente. Selecciónalo en la lista.";
                return;
            }

            NewPatientId = pacienteCreado.PacienteId;
            if (NewPatientTieneSeguro && NewPatientSeguroId > 0)
            {
                var poliza = new
                {
                    PacienteId = pacienteCreado.PacienteId,
                    SeguroId = NewPatientSeguroId,
                    NumeroPoliza = Limpiar(NewPatientNumeroPoliza),
                    Titular = (string?)null,
                    FechaVencimiento = (DateOnly?)null,
                    Observaciones = (string?)null
                };
                using var seguroResponse = await Http.PostAsJsonAsync("api/Seguros/polizas", poliza);
                if (!seguroResponse.IsSuccessStatusCode)
                    ErrorMessage = "Paciente registrado, pero no se pudo asociar la póliza: " + await seguroResponse.Content.ReadAsStringAsync();
            }
            ShowPatientForm = false;
            SuccessMessage = "Paciente registrado y seleccionado. Ya puedes agendar la cita.";
            NewPatientName = NewPatientSurname = NewPatientCedula = NewPatientPhone = NewPatientEmail = "";
            NewPatientNumeroPoliza = "";
            NewPatientSeguroId = 0;
            NewPatientTieneSeguro = false;
        }
        catch (HttpRequestException ex) { ErrorMessage = "No se pudo conectar con la API: " + ex.Message; }
        finally { IsCreatingPatient = false; }
    }

    private static string? Limpiar(string? valor) => string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();

    // GUARDAR UNA CITA
    private async Task SaveAppointment()
    {
        ErrorMessage = "";
        SuccessMessage = "";

        if (NewPatientId <= 0 ||
            string.IsNullOrWhiteSpace(NewType))
        {
            ErrorMessage =
                "Selecciona un paciente y el tipo de cita.";
            return;
        }

        if (NewCost < 0)
        {
            ErrorMessage = "El costo no puede ser negativo.";
            return;
        }

        IsSaving = true;

        try
        {
            var cita = new
            {
                CitaId = EditingCitaId,
                Fecha = NewDateTime,
                PacienteId = NewPatientId,
                TipoCita = NewType.Trim(),
                Costo = NewCost,
                Estado = EditingCitaId == 0 ? "Pendiente" : NewStatus,
                EstadoPago = EditingCitaId == 0 ? "Pendiente" : EstadoPagoActual,
                Observaciones = NewObservations,
                CitaAnteriorId = EditingCitaId == 0 ? (int?)null : CitaAnteriorActual
            };

            using var result = EditingCitaId == 0
                ? await Http.PostAsJsonAsync("api/Citas", cita)
                : await Http.PutAsJsonAsync($"api/Citas/{EditingCitaId}", cita);

            if (result.IsSuccessStatusCode)
            {
                SuccessMessage = EditingCitaId == 0
                    ? "La cita se registró correctamente."
                    : "Los cambios de la cita se guardaron correctamente.";

                ResetForm();

                ShowForm = false;

                await LoadAppointments();
            }
            else
            {
                var detail =
                    await result.Content.ReadAsStringAsync();

                ErrorMessage =
                    "No se pudo guardar la cita. " + detail;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage =
                "Error al guardar la cita: " + ex.Message;
        }
        finally
        {
            IsSaving = false;
        }
    }

    // ACTUALIZAR ESTADO DE UNA CITA
    private async Task UpdateAppointmentStatus(
        AppointmentItem appointment,
        string? nuevoEstado)
    {
        if (string.IsNullOrWhiteSpace(nuevoEstado) ||
            nuevoEstado == appointment.Status)
        {
            return;
        }

        ErrorMessage = "";
        SuccessMessage = "";

        string estadoAnterior = appointment.Status;

        IsUpdatingStatus = true;

        try
        {
            var response = await Http.PatchAsJsonAsync(
                $"api/Citas/{appointment.CitaId}/estado",
                nuevoEstado);

            if (response.IsSuccessStatusCode)
            {
                appointment.Status = nuevoEstado;

                SuccessMessage =
                    "El estado de la cita se actualizó correctamente.";
            }
            else
            {
                appointment.Status = estadoAnterior;

                var detail =
                    await response.Content.ReadAsStringAsync();

                ErrorMessage =
                    "No se pudo actualizar el estado. " + detail;
            }
        }
        catch (Exception ex)
        {
            appointment.Status = estadoAnterior;

            ErrorMessage =
                "Error al actualizar el estado: " + ex.Message;
        }
        finally
        {
            IsUpdatingStatus = false;
        }
    }

    // LIMPIAR FORMULARIO
    private void ResetForm()
    {
        EditingCitaId = 0;
        NewPatientId = 0;
        NewType = "";
        NewDateTime = DateTime.Today.AddDays(1).AddHours(9);
        NewStatus = "Pendiente";
        EstadoPagoActual = "Pendiente";
        CitaAnteriorActual = null;

        NewCost = 0;
        NewObservations = "";
        ShowPatientForm = false;
    }

    // CLASE CSS SEGÚN ESTADO
    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Confirmada" or "Llegó" => "status-confirmed",
            "Atendida" => "status-completed",
            "Pendiente" => "status-pending",
            "Cancelada" => "status-cancelled",
            "Completada" => "status-completed",
            _ => ""
        };
    }

    // RESPUESTA GENERAL DE LA API
    private class ApiResult<T>
    {
        public T? Value { get; set; }
        public bool IsSuccess { get; set; }
    }

    // MODELO DE PACIENTE
    private class PatientItem
    {
        public int PacienteId { get; set; }

        public string Nombre { get; set; } = "";

        public string Apellido { get; set; } = "";

        public string? Telefono { get; set; }
    }

    private class InsuranceItem
    {
        public int SeguroId { get; set; }
        public string Nombre { get; set; } = "";
    }

    // MODELO DE CITA RECIBIDO DE LA API
    private class AppointmentDto
    {
        public int CitaId { get; set; }

        public int PacienteId { get; set; }

        public DateTime Fecha { get; set; }

        public string? TipoCita { get; set; }

        public decimal Costo { get; set; }

        public string Estado { get; set; } = "";

        public string? EstadoPago { get; set; }

        public string? Observaciones { get; set; }

        public int? CitaAnteriorId { get; set; }

        public PatientItem? Paciente { get; set; }
    }

    // MODELO UTILIZADO EN LA INTERFAZ
    private class AppointmentItem
    {
        public int CitaId { get; set; }

        public int PacienteId { get; set; }

        public string Patient { get; set; } = "";

        public string Type { get; set; } = "";

        public DateTime Date { get; set; }

        public string Status { get; set; } = "";

        public decimal Cost { get; set; }

        public string Observations { get; set; } = "";
        public string EstadoPago { get; set; } = "Pendiente";
        public decimal EditedCost { get; set; }
        public string PaymentStatus { get; set; } = "Pendiente";

        public int? CitaAnteriorId { get; set; }
    }
}

