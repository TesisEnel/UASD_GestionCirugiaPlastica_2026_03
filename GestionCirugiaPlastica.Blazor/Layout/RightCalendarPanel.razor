
@using System.Net.Http.Json
@using System.Globalization
@implements IDisposable
@inject HttpClient Http
@inject AuthService Auth
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserProfileState ProfileState

<div class="right-panel-content">

    <!-- PERFIL DEL CONSULTORIO -->
    <AuthorizeView>
        <Authorized Context="session">
            <div class="profile-session">
                <div class="right-profile" role="button" tabindex="0" @onclick="AlternarMenuPerfil" @onkeydown="PerfilKeyDown">
                    <div class="profile-avatar">
                        @if (!string.IsNullOrWhiteSpace(_profile?.FotoUrl))
                        {
                            <img src="@FotoSource(_profile.FotoUrl)" alt="Foto de perfil" />
                        }
                        else
                        {
                            <i class="fa-solid fa-user-doctor"></i>
                        }
                    </div>
                    <div class="profile-info">
                        <strong>@(_profile?.NombreCompleto ?? session.User.Identity?.Name)</strong>
                        <span>@(_profile?.Rol ?? session.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                    </div>
                    <button class="profile-options" type="button" title="Opciones de sesión" @onclick:stopPropagation="true" @onclick="AlternarMenuPerfil">
                        <i class="fa-solid fa-ellipsis"></i>
                    </button>
                </div>
                @if (_menuPerfilAbierto)
                {
                    <div class="profile-dropdown">
                        <a href="/perfil" @onclick:stopPropagation="true"><i class="fa-solid fa-user-pen"></i> Mi perfil</a>
                        <button type="button" @onclick="CerrarSesionAsync"><i class="fa-solid fa-arrow-right-from-bracket"></i> Cerrar sesión</button>
                    </div>
                }
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="guest-profile-session">
                <button type="button" class="right-profile profile-card-button" @onclick="IrALogin">
                    <div class="profile-avatar"><i class="fa-solid fa-user"></i></div>
                    <div class="profile-info"><strong>Invitado</strong><span>Haz clic para iniciar sesión</span></div>
                </button>
                <a class="guest-register-link" href="/registro">¿No tienes cuenta? Regístrate</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>

    <AuthorizeView Roles="Doctora,AsistenteClinico,Secretaria">
        <Authorized>
    <!-- CALENDARIO -->
    <section class="calendar-section">

        <div class="calendar-heading">
            <div>
                <h3>@CurrentMonth.ToString("MMMM yyyy", SpanishCulture)</h3>
                <p>Calendario de citas</p>
            </div>

            <div class="calendar-navigation">
                <button type="button" @onclick="PreviousMonth" title="Mes anterior">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>

                <button type="button" @onclick="NextMonth" title="Mes siguiente">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </div>

        <div class="calendar-grid">

            @foreach (var dayName in WeekDays)
            {
                <div class="calendar-weekday">@dayName</div>
            }

            @foreach (var day in CalendarDays)
            {
                <button type="button"
                        class="calendar-day @(day.IsCurrentMonth ? "" : "other-month") @(day.Date.Date == SelectedDate.Date ? "selected" : "")"
                        aria-label="@CalendarDayLabel(day.Date)"
                        aria-pressed="@(day.Date.Date == SelectedDate.Date)"
                        @onclick="() => SelectDate(day.Date)">
                    <span class="calendar-day-number">@day.Date.Day</span>
                    <span class="calendar-appointment-dot @(HasScheduledAppointments(day.Date) ? "visible" : "hidden")" aria-hidden="true"></span>
                </button>
            }

        </div>

    </section>

    <!-- CITAS DEL DÍA -->
    <section class="appointments-section">

        <div class="appointments-title">
            <div>
                <h3>Citas del día</h3>
                <p>@SelectedDate.ToString("dd 'de' MMMM", SpanishCulture)</p>
            </div>

            <a href="/citas">Ver todas</a>
        </div>

        <div class="appointment-list">

            @if (IsLoading)
            {
                <p>Cargando citas...</p>
            }
            else if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <p>@ErrorMessage</p>
            }
            else if (!AppointmentsForSelectedDate.Any())
            {
                <p>No hay citas programadas para este día.</p>
            }
            else
            {
                @foreach (var appointment in AppointmentsForSelectedDate)
                {
                    <div class="appointment-item">

                        <div class="appointment-time">
                            <strong>@appointment.Date.ToString("hh:mm tt")</strong>
                        </div>

                        <div class="appointment-card @(appointment.Status == "Confirmada" ? "highlight" : "")">
                            <strong>@appointment.Type</strong>
                            <span>@appointment.Patient</span>
                            @if (!string.IsNullOrWhiteSpace(appointment.Reason))
                            {
                                <small>@appointment.Reason</small>
                            }
                        </div>

                    </div>
                }
            }

        </div>

        <div class="appointments-footer">
            <span>@AppointmentsForSelectedDate.Count citas programadas</span>
            <a href="/citas">Ver agenda ↗</a>
        </div>

    </section>
        </Authorized>
    </AuthorizeView>

</div>

@code {

    private bool _menuPerfilAbierto;
    private UserProfileDto? _profile;

    private void IrALogin() => Navigation.NavigateTo("/login");

    private void AlternarMenuPerfil() => _menuPerfilAbierto = !_menuPerfilAbierto;

    private void PerfilKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ") AlternarMenuPerfil();
    }

    private async Task CerrarSesionAsync()
    {
        await Auth.LogoutAsync();
        ProfileState.Set(null);
        _menuPerfilAbierto = false;
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private static readonly CultureInfo SpanishCulture =
        new("es-ES");

    // Mes y fecha seleccionada
    private DateTime CurrentMonth = DateTime.Today;
    private DateTime SelectedDate = DateTime.Today;

    // Estado de carga
    private bool IsLoading = true;
    private string ErrorMessage = "";

    // Días de la semana
    private List<string> WeekDays = new()
    {
        "Do", "Lu", "Ma", "Mi", "Ju", "Vi", "Sá"
    };

    // Días del calendario
    private List<CalendarDay> CalendarDays = new();

    // Citas obtenidas desde la API
    private List<AppointmentItem> Appointments = new();

    // Citas correspondientes al día seleccionado
    private List<AppointmentItem> AppointmentsForSelectedDate =>
        Appointments
            .Where(a => a.Date.Date == SelectedDate.Date &&
                !string.Equals(a.Status?.Trim(), "Cancelada", StringComparison.OrdinalIgnoreCase))
            .OrderBy(a => a.Date)
            .ToList();

    private bool HasScheduledAppointments(DateTime date) => Appointments.Any(a =>
        a.Date.Date == date.Date &&
        !string.Equals(a.Status?.Trim(), "Cancelada", StringComparison.OrdinalIgnoreCase));

    private string CalendarDayLabel(DateTime date)
    {
        var appointmentCount = Appointments.Count(a =>
            a.Date.Date == date.Date &&
            !string.Equals(a.Status?.Trim(), "Cancelada", StringComparison.OrdinalIgnoreCase));

        return appointmentCount == 0
            ? date.ToString("d 'de' MMMM", SpanishCulture)
            : $"{date.ToString("d 'de' MMMM", SpanishCulture)}, {appointmentCount} cita(s)";
    }

    protected override void OnInitialized()
    {
        // Build the month grid synchronously so the day numbers are present on first render.
        GenerateCalendar();
    }

    protected override async Task OnInitializedAsync()
    {
        ProfileState.Changed += ProfileStateChanged;
        _profile = ProfileState.Current;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authenticationState.User.Identity?.IsAuthenticated != true)
                return;

            await LoadProfileAsync();
            if (authenticationState.User.IsInRole("Doctora") ||
                authenticationState.User.IsInRole("AsistenteClinico") ||
                authenticationState.User.IsInRole("Secretaria"))
                await LoadAppointments();
        }
        catch (Exception ex)
        {
            Appointments = new();
            ErrorMessage = "No se pudieron cargar las citas: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadProfileAsync()
    {
        try
        {
            _profile = await Http.GetFromJsonAsync<UserProfileDto>("api/Perfil");
            if (_profile is not null)
                ProfileState.Set(_profile);
        }
        catch (HttpRequestException)
        {
            // El contenido del perfil no debe impedir que se use la agenda.
        }
    }

    private void ProfileStateChanged() => _ = InvokeAsync(() =>
    {
        _profile = ProfileState.Current;
        StateHasChanged();
    });

    private string FotoSource(string fotoUrl)
    {
        if (Uri.TryCreate(fotoUrl, UriKind.Absolute, out var absolute))
            return absolute.ToString();
        return new Uri(Http.BaseAddress!, fotoUrl).ToString();
    }

    public void Dispose() => ProfileState.Changed -= ProfileStateChanged;

    // Cargar citas desde la API
    private async Task LoadAppointments()
    {
        IsLoading = true;
        ErrorMessage = "";

        try
        {
            var resultado = await Http.GetFromJsonAsync<ApiResult<List<AppointmentDto>>>(
                "api/Citas");

            if (resultado?.Value == null)
            {
                Appointments = new();
                ErrorMessage = "No se pudieron obtener las citas.";
                return;
            }

            Appointments = resultado.Value
                .Select(c => new AppointmentItem
                {
                    CitaId = c.CitaId,
                    Date = c.Fecha,
                    Type = c.TipoCita ?? "Sin especificar",
                    Reason = c.Observaciones ?? "",
                    Patient = c.Paciente != null
                        ? $"{c.Paciente.Nombre} {c.Paciente.Apellido}"
                        : $"Paciente #{c.PacienteId}",
                    Status = c.Estado
                })
                .OrderBy(a => a.Date)
                .ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error al cargar las citas: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    // Generar calendario
    private void GenerateCalendar()
    {
        CalendarDays.Clear();

        var firstDay = new DateTime(
            CurrentMonth.Year,
            CurrentMonth.Month,
            1);

        int offset = (int)firstDay.DayOfWeek;

        var startDate = firstDay.AddDays(-offset);

        for (int i = 0; i < 42; i++)
        {
            var date = startDate.AddDays(i);

            CalendarDays.Add(new CalendarDay
            {
                Date = date,
                IsCurrentMonth = date.Month == CurrentMonth.Month
            });
        }
    }

    // Mes anterior
    private void PreviousMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        GenerateCalendar();
    }

    // Mes siguiente
    private void NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        GenerateCalendar();
    }

    // Seleccionar fecha
    private void SelectDate(DateTime date)
    {
        SelectedDate = date;

        if (date.Month != CurrentMonth.Month ||
            date.Year != CurrentMonth.Year)
        {
            CurrentMonth = new DateTime(
                date.Year,
                date.Month,
                1);

            GenerateCalendar();
        }
    }

    // Modelo de los días del calendario
    private class CalendarDay
    {
        public DateTime Date { get; set; }
        public bool IsCurrentMonth { get; set; }
    }

    // Modelo de las citas
    private class AppointmentItem
    {
        public int CitaId { get; set; }
        public DateTime Date { get; set; }
        public string Type { get; set; } = "";
        public string Reason { get; set; } = "";
        public string Patient { get; set; } = "";
        public string Status { get; set; } = "";
    }

    // DTO recibido desde la API
    private class AppointmentDto
    {
        public int CitaId { get; set; }
        public int PacienteId { get; set; }
        public DateTime Fecha { get; set; }
        public string? TipoCita { get; set; }
        public string Estado { get; set; } = "";
        public string? Observaciones { get; set; }
        public PatientDto? Paciente { get; set; }
    }

    private class PatientDto
    {
        public int PacienteId { get; set; }
        public string Nombre { get; set; } = "";
        public string Apellido { get; set; } = "";
    }

    // Respuesta de la API
    private class ApiResult<T>
    {
        public T? Value { get; set; }
    }
}
