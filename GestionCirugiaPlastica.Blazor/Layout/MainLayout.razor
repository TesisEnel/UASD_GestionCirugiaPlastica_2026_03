@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeState ThemeState
@inject IJSRuntime JS

<div class="app-container @(ThemeState.IsDark ? "theme-dark" : "")">

    <!-- COLUMNA 1: MENÚ LATERAL -->
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <!-- COLUMNA 2: CONTENIDO CENTRAL -->
    <main class="main-content">

        <header class="dashboard-header">
            <AuthorizeView Roles="Doctora,Secretaria">
                <Authorized Context="staffHeaderContext">
                    <div class="header-welcome">
                        <div class="doctor-avatar"><i class="fa-solid fa-user-doctor"></i></div>
                        <div><h2>Bienvenido</h2><p>Panel de control del consultorio</p></div>
                    </div>
                    <div class="header-actions">
                        <div class="search-box"><i class="fa-solid fa-magnifying-glass"></i><input type="text" placeholder="Buscar aquí..." /></div>
                        <AuthorizeView Roles="Doctora"><Authorized Context="doctorHeaderContext"><NotificationBell /></Authorized></AuthorizeView>
                    </div>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="AsistenteClinico">
                <Authorized>
                    <div class="header-welcome">
                        <div class="doctor-avatar"><i class="fa-solid fa-user-nurse"></i></div>
                        <div><h2>Área clínica</h2><p>Expedientes y seguimiento médico</p></div>
                    </div>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Paciente">
                <Authorized>
                    <div class="header-welcome">
                        <div class="doctor-avatar"><i class="fa-solid fa-user"></i></div>
                        <div><h2>Mi portal de paciente</h2><p>Consulta tu perfil, citas y recetas</p></div>
                    </div>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView>
                <NotAuthorized Context="guestHeaderContext">
                    <div class="header-welcome">
                        <div class="doctor-avatar"><i class="fa-solid fa-heart-pulse"></i></div>
                        <div><h2>Tanger Clinic</h2><p>Cirugía plástica · Atención personalizada</p></div>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <!-- CONTENIDO DE CADA PÁGINA -->
        <section class="dashboard-content">
            @Body
        </section>

    </main>

    <!-- COLUMNA 3: CALENDARIO Y CITAS -->
    <aside class="right-panel"><RightCalendarPanel /></aside>

</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ThemeState.Changed += ThemeChanged;
        await ThemeState.InitializeAsync(JS);
    }

    private void ThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.Changed -= ThemeChanged;
}


